# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
WORKERS=1
LOG_LEVEL=INFO

# HTTP Client Settings
HTTP_TIMEOUT=20
MAX_CONNECTIONS=100
MAX_KEEPALIVE_CONNECTIONS=20
KEEPALIVE_EXPIRY=5
HTTP_RETRIES=3

# Cache Settings
CACHE_TTL_M3U8=60
CACHE_TTL_SEGMENT=300
CACHE_NAMESPACE=proxy

# Proxy Settings
PROXY_BASE_PATH=proxy?url=
PROXY_MAX_REDIRECTS=5
PROXY_BUFFER_SIZE=8192

# yt-dlp Settings
YTDLP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/139.0.0.0 Safari/537.36
YTDLP_PO_TOKEN=
YTDLP_CLIENT_VISITOR_ID=
YTDLP_LEGACY_SERVER_CONNECT=False
YTDLP_NO_CHECK_CERTIFICATES=False
YTDLP_PREFER_INSECURE=False
YTDLP_PROXY=

# yt-dlp EJS (External JavaScript) Settings
# Required for full YouTube support since yt-dlp 2025.11.12
YTDLP_EJS_ENABLED=True
YTDLP_EJS_RUNTIME=deno
# Supported runtimes: deno, nodejs, quickjs, bun
YTDLP_EJS_REMOTE_COMPONENTS=ejs:github
# Options: ejs:github, ejs:npm

# Stream Extraction Settings
STREAM_DEFAULT_VIDEO_QUALITY=source
STREAM_AUDIO_QUALITY_PREFIX=audio
STREAM_UNKNOWN_HEIGHT_LABEL=?
STREAM_MAX_STREAMS=50

# Security Settings
MAX_REQUEST_SIZE=1048576
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Debug Settings
DEBUG_ENABLE_DEBUG_ENDPOINTS=False
DEBUG_LOG_REQUESTS=True
DEBUG_LOG_RESPONSES=False
DEBUG_VERBOSE_ERRORS=False
